{
  "realm": "psy",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "sslRequired": "external",
  "roles": {
    "realm": [
      { "name": "therapist", "description": "Practice therapist" },
      { "name": "admin", "description": "System administrator" }
    ]
  },
  "users": [
    {
      "username": "therapist",
      "enabled": true,
      "email": "therapist@psy.local",
      "emailVerified": true,
      "firstName": "Anna",
      "lastName": "Therapist",
      "credentials": [
        {
          "type": "password",
          "value": "__KEYCLOAK_THERAPIST_PASSWORD__",
          "temporary": false
        }
      ],
      "realmRoles": ["therapist", "default-roles-psy"]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@psy.local",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "PSY",
      "credentials": [
        {
          "type": "password",
          "value": "__KEYCLOAK_USER_ADMIN_PASSWORD__",
          "temporary": false
        }
      ],
      "realmRoles": ["admin", "therapist", "default-roles-psy"]
    }
  ],
  "clients": [
    {
      "clientId": "psy-web",
      "name": "PSY Web",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost/*",
        "http://127.0.0.1:5173/*",
        "http://127.0.0.1/*",
        "__APP_PUBLIC_URL__/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost",
        "http://127.0.0.1:5173",
        "http://127.0.0.1",
        "__APP_PUBLIC_URL__",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocol": "openid-connect"
    },
    {
      "clientId": "psy-api",
      "name": "PSY API",
      "enabled": true,
      "publicClient": false,
      "secret": "__PSY_API_CLIENT_SECRET__",
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    }
  ]
}
