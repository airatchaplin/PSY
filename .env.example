# === Public URLs (set to your hosting domain before build/deploy) ===
APP_PUBLIC_URL=https://your-domain.example
VITE_API_URL=https://api.your-domain.example
VITE_KEYCLOAK_URL=https://auth.your-domain.example
VITE_KEYCLOAK_REALM=psy
VITE_KEYCLOAK_CLIENT_ID=psy-web
PSY_CORS_ORIGINS=https://your-domain.example,https://www.your-domain.example

# Vault (compose -dev root token)
VAULT_TOKEN=change-me-long-random-token

# Optional: bootstrap LLM key into Vault only. Prefer Admin UI after first login.
# PSY_LLM_API_KEY=sk-your-key

# Postgres
POSTGRES_USER=psy
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=psy

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-strong-kc-admin
KEYCLOAK_THERAPIST_PASSWORD=change-me-strong-therapist
KEYCLOAK_USER_ADMIN_PASSWORD=change-me-strong-app-admin
PSY_API_CLIENT_SECRET=change-me-strong-api-client-secret
PSY_KEYCLOAK_REALM=psy

# MinIO
PSY_MINIO_IMAGE=minio/minio:latest
PSY_MINIO_ENABLED=true
PSY_MINIO_ACCESS_KEY=change-me-minio-access
PSY_MINIO_SECRET_KEY=change-me-strong-minio-secret
PSY_MINIO_BUCKET=psy-prompts
